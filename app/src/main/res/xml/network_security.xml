<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Same as before this file existed (android:usesCleartextTraffic="true" is ignored once it does). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Apple's aerials (Aerial.kt) come from a server signed by Apple's own root, which isn't in Android's
         store. Trust that root for this one host only (res/raw/apple_root_ca.cer, from apple.com/certificateauthority,
         SHA-256 B0:B1:73:0E:CB:C7:FF:45:05:14:2C:49:F1:29:5E:6E:DA:6B:CA:ED:7E:2C:68:C5:BE:91:B5:A1:10:01:F0:24). -->
    <domain-config>
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="@raw/apple_root_ca" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
